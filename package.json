{
  "name": "tales-of-valora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node RELEASE/serve.cjs",
    "test": "node --test RELEASE/tests/stats.test.mjs RELEASE/tests/world-characters.test.mjs RELEASE/tests/audio.test.mjs UNPUBLISHED/Legacy3D/tests/world.test.mjs",
    "test:game": "npm --prefix RELEASE run test:game",
    "test:private": "npm run test:game",
    "stats": "node RELEASE/build-stats.cjs",
    "build:site": "node RELEASE/build-site.cjs",
    "test:site": "node RELEASE/site-build-check.cjs"
  },
  "description": "Tales of Valora: RELEASE contains the supported game; UNPUBLISHED preserves development work."
}
